{
  "name": "kubedeck",
  "version": "2.13.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/desktop",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "npm --workspace apps/desktop run dev",
    "build": "npm --workspace apps/desktop run build",
    "typecheck": "npm --workspace apps/desktop run typecheck",
    "test:renderer": "npm --workspace apps/desktop run test:renderer",
    "lint": "biome lint apps/desktop/src apps/desktop/tests scripts",
    "format:check": "biome format .",
    "verify": "npm run lint && npm run format:check && npm run test:renderer && npm run typecheck && npm run build && npm --workspace apps/desktop run test:gateway",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-portable-windows.ps1",
    "test:gateway": "npm --workspace apps/desktop run build && npm --workspace apps/desktop run test:gateway",
    "verify:node-only": "node scripts/verify-release.cjs",
    "verify:release": "node scripts/verify-release.cjs",
    "package:mac": "bash ./scripts/build-macos.sh",
    "package:linux": "bash ./scripts/build-linux.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "7zip-bin": "^5.2.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true,
    "fsevents@2.3.3": true,
    "electron@43.1.0": true
  }
}
